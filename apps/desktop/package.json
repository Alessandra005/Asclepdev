{
  "name": "asclep-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Asclep desktop app (Electron + React 18 + Blueprint). Lives in apps/desktop in the team repo.",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "cross-env VITE_USE_MOCKS=true electron-vite dev",
    "demo:host": "cross-env ASCLEP_DEMO_HOST=1 VITE_DEMO_SERVER=http://localhost:8787 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/renderer/api/schema.d.ts",
    "test:e2e": "cross-env VITE_USE_MOCKS=true electron-vite build && playwright test"
  },
  "dependencies": {
    "@blueprintjs/core": "6.20.0",
    "@blueprintjs/datetime": "6.2.6",
    "@blueprintjs/icons": "6.14.1",
    "@blueprintjs/select": "6.3.6",
    "@blueprintjs/table": "6.2.6",
    "@tanstack/react-query": "5.104.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "3.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "electron": "38.8.6",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
