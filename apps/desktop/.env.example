# Copy to .env. Never commit .env.
# Gateway base URL (Ron's FastAPI). Paths are appended under /api/v1.
VITE_GATEWAY_URL=http://localhost:8000
# true (also the default when unset) = in-memory mock gateway, spec 16 seed, no backend needed.
# false = talk to the real gateway at VITE_GATEWAY_URL.
VITE_USE_MOCKS=true
# Mixed mode (mocks on): these paths go to the real gateway instead. `*` = one path segment.
# Go live in this order: auth first, so every mocked route still gets a valid session.
# VITE_LIVE_ROUTES=/auth/login,/me,/patients,/patients/*
VITE_LIVE_ROUTES=
