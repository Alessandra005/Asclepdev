# Copy to infra/.env. Never commit the real .env.
POSTGRES_USER=asclep
POSTGRES_PASSWORD=asclep
POSTGRES_DB=asclep
DATABASE_URL=postgresql+psycopg2://asclep:asclep@postgres:5432/asclep
JWT_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
HF_TOKEN=
LABTECH_MOCK=1
LABTECH_BACKBONE=conch
RESIDENT_MOCK=1
VLM_URL=http://vlm:8000/v1
MONGO_URL=mongodb://mongo:27017
MONGO_DB=asclep
# LiveScribing (Resident). RESIDENT_MOCK=1 plays a scripted visit; 0 uses the local VLM + Whisper.
# VLM_URL: the compose `vlm` service (GPU), or a llama.cpp server on this PC: http://host.docker.internal:8300/v1
VLM_MODEL=Qwen3-VL-4B-Instruct
WHISPER_MODEL=base.en
# Timezone for "today" in schedules and seeded appointments (spec 16: Gregory 10:30, Linda 11:15)
DEMO_TZ=America/New_York
